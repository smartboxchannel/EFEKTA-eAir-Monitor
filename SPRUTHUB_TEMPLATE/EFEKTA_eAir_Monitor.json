{
  "name": "EFEKTA eAir Monitor",
  "manufacturer": "EfektaLab",
  "model": "EFEKTA_eAir_Monitor",
  "manufacturerIds": [
    "EfektaLab"
  ],
  "modelIds": [
    "EFEKTA_eAir_Monitor"
  ],
  "catalogId": 0,
  "template": [
    "/_Battery/BatteryPercentageRemaining.json"
  ],
  "init": [
    {
      "zcl": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "F004_Custom",
          "zclDataType": "UNSIGNED_8_BIT_INTEGER"
        },
		{
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0201_Custom",
          "zclDataType": "UNSIGNED_16_BIT_INTEGER"
        },
        {
          "endpoint": 1,
          "cluster": "040D_CarbonDioxide",
          "attribute": "0202_Custom",
          "zclDataType": "BOOLEAN"
        },
        {
          "endpoint": 1,
          "cluster": "040D_CarbonDioxide",
          "attribute": "0207_Custom",
          "zclDataType": "UNSIGNED_16_BIT_INTEGER"
        },
        {
          "endpoint": 1,
          "cluster": "040D_CarbonDioxide",
          "attribute": "0402_Custom",
          "zclDataType": "BOOLEAN"
        },
        {
          "endpoint": 1,
          "cluster": "040D_CarbonDioxide",
          "attribute": "0206_Custom",
          "zclDataType": "BOOLEAN"
        }
      ]
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "040D_CarbonDioxide",
          "attribute": "0000_MeasuredValue"
        }
      ],
      "bind": false,
      "report": false
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "000A_Time",
          "attribute": "0007_LocalTime"
        }
      ],
      "bind": false,
      "report": false
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0021_BatteryPercentageRemaining"
        }
      ],
      "bind": false,
      "report": false
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "003E_BatteryAlarmState"
        }
      ],
      "bind": false,
      "report": false
    }
  ],
  "services": [
    {
      "type": "CarbonDioxideSensor",
      "logics": [
        {
          "type": "CarbonDioxideDetectedFromCarbonDioxideLevel"
        }
      ],
      "characteristics": [
        {
          "type": "CarbonDioxideLevel",
          "link": [
            {
              "endpoint": 1,
              "cluster": "040D_CarbonDioxide",
              "attribute": "0000_MeasuredValue"
            }
          ]
        }
      ]
    }
  ],
  "options": [
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "000A_Time",
          "attribute": "0007_LocalTime"
        }
      ],
      "name": "Время работы",
      "description": "Время работы устройства в часах, с момента производства",
      "type": "Integer",
      "unit": "час",
      "write": false,
      "value": 0,
      "inputType": "STATUS"
    },
	{
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0201_Custom"
        }
      ],
      "name": "Режим работы",
	  "description": "Режим опроса сенсора CO2, рекомендуется 5-ти минутный интервал опроса. Чем чаже опрашивается, тем больше расход заряда батареек.",
      "type": "Integer",
      "value": 5,
      "values": [
        {
          "value": 1,
          "name": "1 минута"
        },
        {
          "value": 5,
          "name": "5 минут"
        },
        {
          "value": 10,
          "name": "10 минут"
        }
      ]
    },
	{
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "F004_Custom"
        }
      ],
      "name": "Инвертирование цвета e-paper дисплея",
      "type": "Integer",
      "value": 1,
      "values": [
        {
          "value": 0,
          "name": "Черное на белом"
        },
        {
          "value": 1,
          "name": "Белое на черном"
        }
      ]
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "040D_CarbonDioxide",
          "attribute": "0202_Custom"
        }
      ],
      "name": "Форсированная калибровка датчика на атмосферный уровень CO2 (430ppm)",
      "description": "Оставить датчик на свежем воздуже, минимум на 15 минут, через 15 минут включить калибровку",
      "type": "Boolean",
      "value": false
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "040D_CarbonDioxide",
          "attribute": "0207_Custom"
        }
      ],
      "name": "Форсированная калибровка датчика по данным с другого СО2 датчика",
      "description": "Выполняется в стабильной воздушной среде, без сквозняков, оставить 2 датчика рядом минимум на 20 минут и после отправить значение с поверочного датчика",
      "unit": "ppm",
      "type": "Integer",
      "value": 0,
      "minValue": 0,
      "maxValue": 5000
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "040D_CarbonDioxide",
          "attribute": "0402_Custom"
        }
      ],
      "name": "Переодическая автокалибровка сенсора CO2",
      "description": "Включение переодической автокалибровки сенсора CO2, цикл сбора данных 1 неделя, рекомендуется включить",
      "type": "Boolean",
      "value": true
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "040D_CarbonDioxide",
          "attribute": "0206_Custom"
        }
      ],
      "name": "Сброс сенсора CO2 на заводские настройки",
      "type": "Boolean",
      "value": false
    }
  ]
}